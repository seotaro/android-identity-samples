<!--
  Backup rules for Android 12 (API 31) and higher.
  The "auth" DataStore holds the session ID and sign-in state. Exclude it so a restored
  session is not copied to the new device; Restore Credentials signs the user in instead.
  https://developer.android.com/identity/sign-in/restore-credentials
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
